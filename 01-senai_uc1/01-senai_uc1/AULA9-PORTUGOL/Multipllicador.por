programa {
  funcao inicio() {
    inteiro n1,resposta
    escreva("Qual numero deseja multiplicar por 10x?\n")
    leia(n1)
    resposta=multiplicador(n1)
    escreva("A sua resposta é\n",resposta)



    }funcao  inteiro multiplicador(inteiro n1) {
      inteiro mult
      mult=n1*10
      retorne mult
    

    }
    
  }
    
  




    


    
  

