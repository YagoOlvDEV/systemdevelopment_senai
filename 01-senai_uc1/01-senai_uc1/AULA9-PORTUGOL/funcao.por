programa
{
	
	funcao inicio()
	{
		mensagem("Senai","cursos",2026)
	}
	
	
	funcao mensagem(cadeia empresa,cadeia texto,inteiro ano){
		escreva("************","\n")
		escreva("***",empresa,"-",ano,"***","\n")
	}
}
