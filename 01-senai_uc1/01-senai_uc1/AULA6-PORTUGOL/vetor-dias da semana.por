programa {
  funcao inicio() {
    cadeia  diasSemana[7]
    diasSemana[0]="Domingo"
    diasSemana[1]="Segunda"
    diasSemana[2]="Terça"
    diasSemana[3]="Quarta"
    diasSemana[4]="Quinta"
    diasSemana[5]="Sexta"
    diasSemana[6]="Sabado"


    para(inteiro i=0;i<7;i++){
      escreva(diasSemana[i],"\n")
    }

    
  }
}
